<?xml version='1.0' encoding='UTF-8'?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="CloudMall short steady bounded 5 workers 20 identities" enabled="true">
      <stringProp name="TestPlan.comments">One separate stage, threads 1/2/5 only, one transaction per VU; root controls stage ordering and total 8 trades.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="profile" elementType="Argument">
            <stringProp name="Argument.name">profile</stringProp>
            <stringProp name="Argument.value">${__P(cloudmall.profile,SHORT_STEADY_BOUNDED)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="host" elementType="Argument">
            <stringProp name="Argument.name">host</stringProp>
            <stringProp name="Argument.value">${__P(cloudmall.host,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="port" elementType="Argument">
            <stringProp name="Argument.name">port</stringProp>
            <stringProp name="Argument.value">${__P(cloudmall.port,8080)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="stockPort" elementType="Argument">
            <stringProp name="Argument.name">stockPort</stringProp>
            <stringProp name="Argument.value">${__P(cloudmall.stockPort,8085)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="payPort" elementType="Argument">
            <stringProp name="Argument.name">payPort</stringProp>
            <stringProp name="Argument.value">${__P(cloudmall.payPort,8086)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="skuId" elementType="Argument">
            <stringProp name="Argument.name">skuId</stringProp>
            <stringProp name="Argument.value">${__P(cloudmall.skuId,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="runId" elementType="Argument">
            <stringProp name="Argument.name">runId</stringProp>
            <stringProp name="Argument.value">${__P(cloudmall.runId,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="outputDir" elementType="Argument">
            <stringProp name="Argument.name">outputDir</stringProp>
            <stringProp name="Argument.value">${__P(cloudmall.outputDir,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="expectedProductId" elementType="Argument">
            <stringProp name="Argument.name">expectedProductId</stringProp>
            <stringProp name="Argument.value">${__P(cloudmall.productId,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="expectedPrice" elementType="Argument">
            <stringProp name="Argument.name">expectedPrice</stringProp>
            <stringProp name="Argument.value">${__P(cloudmall.price,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="expectedAvailable" elementType="Argument">
            <stringProp name="Argument.name">expectedAvailable</stringProp>
            <stringProp name="Argument.value">${__P(cloudmall.available,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="threads" elementType="Argument">
            <stringProp name="Argument.name">threads</stringProp>
            <stringProp name="Argument.value">${__P(cloudmall.threads,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="setupBudgetMillis" elementType="Argument">
            <stringProp name="Argument.name">setupBudgetMillis</stringProp>
            <stringProp name="Argument.value">${__P(cloudmall.setupBudgetMillis,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TRADE_SHORT_STEADY" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">stopthread</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Exactly one transaction per VU" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">4</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">5</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </ThreadGroup>
